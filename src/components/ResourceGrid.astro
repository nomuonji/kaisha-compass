---
import ResourceCard from "./ResourceCard.astro";
import type { Resource } from "../lib/data";
interface Props { resources:Resource[]; searchable?:boolean; }
const { resources,searchable=false }=Astro.props;
---
{searchable&&<div class="library-tools">
  <label class="search-box">
    <span class="search-mark" aria-hidden="true">⌕</span><span class="sr-only">教材を検索</span>
    <input data-resource-search type="search" placeholder="社会保険、役員変更、資金繰り…" autocomplete="off" />
  </label>
  <div class="filter-row" aria-label="情報源で絞り込み">
    <button class="filter-chip active" type="button" data-source-filter="all">ALL</button>
    <button class="filter-chip" type="button" data-source-filter="official">OFFICIAL</button>
    <button class="filter-chip" type="button" data-source-filter="practical">PRACTICAL</button>
  </div>
  <button class="reset-button" type="button" data-resource-reset>RESET</button>
</div>}
<div class="resource-grid" data-resource-grid>{resources.map((resource,index)=><ResourceCard resource={resource} index={index}/>)}</div>
<p class="empty-state" data-resource-empty hidden>該当する教材がありません。検索語や絞り込みを変更してください。</p>
{searchable&&<script is:inline src="/library.js"></script>}
