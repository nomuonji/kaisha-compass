---
interface Props { size?: number; compact?: boolean; }
const { size=40, compact=false }=Astro.props;
---
<span class:list={["compass-mark",compact&&"compact"]} style={"--mark-size:"+size+"px"} aria-hidden="true">
  <svg viewBox="0 0 44 44">
    <circle cx="22" cy="22" r="20.5"></circle>
    <path d="M22 8.5 27.2 22 22 35.5 16.8 22 22 8.5Z"></path>
    <circle class="needle-dot" cx="22" cy="22" r="2.7"></circle>
  </svg>
</span>
