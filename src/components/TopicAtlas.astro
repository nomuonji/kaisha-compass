---
import SectionHeading from "./SectionHeading.astro";
import { topicMeta,resourcesForTopic,type TopicId } from "../lib/data";
---
<section class="section atlas-section shell" id="topics">
  <SectionHeading number="04" eyebrow="レベル2 / 専門領域" title="専門領域から探す" description="会社法・税務・労務・会計・財務・契約ごとに関連する場面と資料を確認できます。"/>
  <div class="topic-grid">
    {Object.entries(topicMeta).map(([id,meta],index)=><a class="topic-card" href={"/topics/"+id+"/"} style={"--topic-color:"+meta.color}>
      <span class="destination-eyebrow"><span class="dest-tag topic">2 領域</span> 専門領域</span><span class="topic-meta"><span class="topic-index">{String(index+1).padStart(2,"0")}</span><span>{resourcesForTopic(id as TopicId).length} 件</span></span>
      <h3>{meta.label}</h3><p>{meta.description}</p>
    </a>)}
  </div>
</section>
