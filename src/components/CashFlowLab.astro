---
import "../styles/interactive-lessons.css";
import {cashStages} from "../lib/interactiveModels.mjs";
const initial=cashStages[0];
const yen=(v:number)=>v.toLocaleString("ja-JP")+"円";
---
<section class="kc-lab kc-cash-lab" data-kc-cash data-step="0" aria-label="売上と現金の違いを操作して理解する">
 <header class="kc-lab-header">
  <div>
   <p class="kc-kicker">01 <span>/</span> 会社のお金を動かす</p>
   <h2>10万円売れた。<br/><em>なのに、お金がない？</em></h2>
   <p class="kc-lab-lede">架空のWeb制作会社の一日。受注、納品、外注費の支払い、入金を切り替えると、「売上」と「現金」が別々に動くことが見えてきます。</p>
  </div>
  <span class="kc-stamp" aria-hidden="true">¥<i>≠</i>¥</span>
 </header>
 <div class="kc-lab-inner">
  <div class="kc-step-switch" role="group" aria-label="会社のお金の流れを選ぶ">
   {cashStages.map((s,i)=><button type="button" data-cash-step={i} aria-pressed={i===0}>
     <small>{String(i+1).padStart(2,"0")}</small><strong>{s.label}</strong><span aria-hidden="true">↗</span>
   </button>)}
  </div>
  <div class="kc-cash-diagram" aria-hidden="true">
   <div class="kc-entity kc-client">
    <span>01 / CUSTOMER</span>
    <svg viewBox="0 0 90 80" fill="none"><rect x="15" y="20" width="60" height="44" rx="2" stroke="currentColor" stroke-width="2"/><path d="M10 21 45 5l35 16M28 33h34M28 45h34M28 57h24" stroke="currentColor" stroke-width="2"/></svg>
    <strong>顧客</strong><small>仕事を依頼する</small>
   </div>
   <div class="kc-route kc-route-one"><small data-cash-instruction>仕事の依頼</small><svg viewBox="0 0 90 30" preserveAspectRatio="none"><path d="M3 15H87M76 4l11 11-11 11" fill="none" stroke="currentColor" stroke-width="2"/></svg></div>
   <div class="kc-entity kc-company">
    <span>02 / COMPANY</span>
    <svg viewBox="0 0 90 80" fill="none"><path d="M17 69V25l28-14 28 14v44M9 69h72M17 38h56M17 51h56M45 11v58" stroke="currentColor" stroke-width="2"/><path d="M29 30h8m15 0h8M29 43h8m15 0h8" stroke="currentColor" stroke-width="3"/></svg>
    <strong>制作会社</strong><small>納品・請求する</small>
   </div>
   <div class="kc-route kc-route-two"><small>銀行に入金</small><svg viewBox="0 0 90 30" preserveAspectRatio="none"><path d="M3 15H87M76 4l11 11-11 11" fill="none" stroke="currentColor" stroke-width="2"/></svg></div>
   <div class="kc-entity kc-bank">
    <span>03 / BANK</span>
    <svg viewBox="0 0 90 80" fill="none"><path d="M8 25 45 6l37 19H8ZM14 68h62M9 75h72M23 30v34M38 30v34M52 30v34M67 30v34" stroke="currentColor" stroke-width="2"/></svg>
    <strong>銀行口座</strong><small>いま使えるお金</small>
   </div>
  </div>
  <div class="kc-current" aria-live="polite"><span>いま起きていること</span><strong data-cash-action>{initial.action}</strong></div>
  <div class="kc-ledger" aria-label="選択した場面の金額">
   <div><span>売上として記録</span><strong data-cash-revenue>{yen(initial.revenue)}</strong><small>収益の記録</small></div>
   <div><span>まだ受け取っていない</span><strong data-cash-receivable>{yen(initial.receivable)}</strong><small>売掛金</small></div>
   <div class="kc-ledger-accent"><span>銀行口座の残高</span><strong data-cash-balance>{yen(initial.cash)}</strong><small>初期の5万円を含む</small></div>
  </div>
  <div class="kc-explain-row">
   <div class="kc-story" aria-live="polite"><span>この場面で分かること</span><h3 data-cash-headline>{initial.headline}</h3><p data-cash-explanation>{initial.explanation}</p></div>
   <div class="kc-bars"><span>口座残高はこう動く</span><div class="kc-chart">
     {cashStages.map((s,i)=><div class="kc-chart-column"><div class="kc-chart-track"><i style={"height:"+Math.max(8,s.cash/110000*100)+"%"} class:list={{"is-current":i===0}} data-cash-bar={i}></i></div><small>{s.label}</small></div>)}
   </div></div>
  </div>
  <footer class="kc-lab-footer">
   <p>初期残高5万円、サービス納品時に売上10万円を計上し、外注費4万円を支払う単純化した例です。税金・その他の費用・実際の支払期限は含みません。</p>
   <a href="/journey/first-contract/"><span class="dest-tag scene">1 場面</span>初受注から入金までを詳しく読む →</a>
  </footer>
 </div>
</section>
<script>import "../scripts/interactive-explainers.js";</script>
