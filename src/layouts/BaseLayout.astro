---
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import HierarchyBar from "../components/HierarchyBar.astro";

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown> | Record<string, unknown>[];
  level?: "overview"|"scene"|"topic"|"source";
  levelDetail?: string;
}
const {
  title = "Kaisha Compass — 会社運営の学習地図",
  description = "一社の会社運営を追いながら、法務・税務・労務・会計・財務を信頼できる教材で学ぶナビゲーションサイト。",
  ogImage = "/og-default.svg",
  noindex = false,
  schema,
  level = "overview",
  levelDetail
} = Astro.props;
const pageTitle = title.includes("Kaisha Compass") ? title : title + " | Kaisha Compass";
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const absoluteOg = Astro.site ? new URL(ogImage, Astro.site) : ogImage;
const shouldTrack = import.meta.env.PROD && Astro.url.hostname === "kaisha-compass.antonbase.com";
---
<!doctype html>
<html lang="ja">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#f2efe7" />
  {noindex && <meta name="robots" content="noindex,nofollow" />}
  {canonical && <link rel="canonical" href={canonical} />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={absoluteOg} />
  <meta property="og:locale" content="ja_JP" />
  <meta name="twitter:card" content="summary_large_image" />
  <title>{pageTitle}</title>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)} />}
  {shouldTrack && (
    <>
      <script async src="https://www.googletagmanager.com/gtag/js?id=G-XBZ6F1EPDR"></script>
      <script is:inline define:vars={{ measurementId: "G-XBZ6F1EPDR" }}>
        window.dataLayer = window.dataLayer || [];
        function gtag(){window.dataLayer.push(arguments);}
        gtag("js", new Date());
        gtag("config", measurementId);
      </script>
    </>
  )}
</head>
<body class={"page-level-"+level}>
  <div class="top-rule" aria-hidden="true"></div>
  <SiteHeader />
  <HierarchyBar current={level} detail={levelDetail} />
  <main><slot /></main>
  <SiteFooter />
</body>
</html>
