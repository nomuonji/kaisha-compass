---
import BaseLayout from "../layouts/BaseLayout.astro";
import CompassHero from "../components/CompassHero.astro";
import CompanyCase from "../components/CompanyCase.astro";
import ReadingJourney from "../components/ReadingJourney.astro";
import TopicAtlas from "../components/TopicAtlas.astro";
import MethodSection from "../components/MethodSection.astro";
import SectionHeading from "../components/SectionHeading.astro";
import ResourceGrid from "../components/ResourceGrid.astro";
import { resources,sortResources,stats } from "../lib/data";
const featured=sortResources(resources).slice(0,8);
const schema={"@context":"https://schema.org","@type":"WebSite",name:"Kaisha Compass",description:"会社運営を、点ではなく流れで学ぶ。会社の一年と信頼できる外部教材をつなぐ学習ナビゲーション。",inLanguage:"ja"};
---
<BaseLayout schema={schema} level="overview" levelDetail="全体マップ">
  <CompassHero/>
  <CompanyCase/>
  <ReadingJourney/>

  <section class="topic-after-story">
    <div class="shell">
      <div class="story-transition">
        <p class="section-type-label topic-type">レベル2 / 専門領域</p>
        <h2>専門領域から確認する</h2>
        <p>法務・税務・労務・会計・財務・契約ごとに、関連する場面と資料を確認できます。</p>
      </div>
      <TopicAtlas/>
    </div>
  </section>

  <section class="library-section quiet-library" id="library"><div class="shell">
    <SectionHeading number="05" eyebrow="レベル3 / 資料要約" title="資料一覧" description={stats.resources+"件の公式資料・実務解説を検索できます。"}/>
    <ResourceGrid resources={featured}/>
    <div class="section-cta"><a class="action primary" href="/resources/">全{stats.resources}件の資料を見る <span>→</span></a></div>
  </div></section>

  <section class="shell" aria-label="補足解説" style="padding-block:24px 36px">
    <p class="section-type-label topic-type">追加の読み物</p>
    <h2>補足解説</h2>
    <p>会社の一年を読んだあとに、個別の制度や実務上の論点を確認できます。</p>
    <p><a href="/features/">補足解説を見る →</a></p>
  </section>

  <MethodSection/>
</BaseLayout>
