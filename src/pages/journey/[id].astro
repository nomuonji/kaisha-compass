---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { events,resourcesForEvent,sortResources,topicsForEvent,topicMeta,type CompanyEvent } from "../../lib/data";
import { eventGuides } from "../../lib/eventGuides";
import ChapterOrientation from "../../components/ChapterOrientation.astro";

export function getStaticPaths(){
  return events.map(event=>({params:{id:event.id},props:{event}}));
}

const { event }=Astro.props as { event:CompanyEvent };
const guide=eventGuides[event.id];
const linked=sortResources(resourcesForEvent(event.id));
const topics=topicsForEvent(event.id);
const currentIndex=events.findIndex(item=>item.id===event.id);
const previous=currentIndex>0?events[currentIndex-1]:undefined;
const next=currentIndex<events.length-1?events[currentIndex+1]:undefined;

const sourceNotes=(guide?.sourceNotes??[]).map(note=>({
  ...note,
  resource:linked.find(resource=>resource.id===note.resourceId)
})).filter(item=>item.resource);

const otherSources=linked.filter(resource=>!sourceNotes.some(note=>note.resourceId===resource.id));

const schema={"@context":"https://schema.org","@type":"LearningResource",name:event.title,description:event.summary,inLanguage:"ja",learningResourceType:"case study"};
---
<BaseLayout title={event.title} description={event.summary} schema={schema} level="scene" levelDetail={event.title}>
  <Breadcrumbs items={[{label:"会社の一年",href:"/#journey"},{label:event.title}]}/>

  <article class="chapter shell">
    <header class="chapter-header">
      <div class="chapter-index">
        <span>{String(currentIndex+1).padStart(2,"0")}</span>
        <small>{event.month}</small>
      </div>
      <div class="chapter-title">
        <p class="page-type-label scene-type">レベル1 / 場面</p>
        <h1>{event.title}</h1>
        <p class="chapter-deck">{event.summary}</p>
      </div>
    </header>

    {guide?.keyPoints?.length>0&&<section class="scene-learning-map" aria-labelledby="scene-learning-title">
      <div><p class="page-type-label scene-type">レベル1 / 場面</p><h2 id="scene-learning-title">この場面で学ぶこと</h2></div>
      <ol>{guide.keyPoints.slice(0,4).map((point,i)=><li><span>{String(i+1).padStart(2,"0")}</span><strong>{point.title}</strong></li>)}</ol>
    </section>}
    <ChapterOrientation events={events} currentId={event.id}/>
    <nav class="chapter-in-page shell" aria-label="この場面の内容">
      <strong>この章の内容</strong>
      <a href="#chapter-points">重要ポイント ↓</a>
      <a href="#chapter-steps">実務上の手順 ↓</a>
      {sourceNotes.length>0&&<a href="#chapter-sources">資料要約 ↓</a>}
      {otherSources.length>0&&<a href="#chapter-other-sources">関連資料 ↓</a>}
    </nav>
    <div class="chapter-reading">
      <aside class="chapter-margin">
        <p>関連する専門領域</p>
        <nav>
          {topics.map(topic=><a class="typed-link compact" href={"/topics/"+topic+"/"}><span class="dest-tag topic">2 領域</span>{topicMeta[topic].label}</a>)}
        </nav>
      </aside>

      <div class="chapter-prose">
        {guide?.intro?.map(paragraph=><p class="lead-paragraph">{paragraph}</p>)}

        {guide?.takeaway&&
          <aside class="chapter-thesis">
            <span>要点</span>
            <p>{guide.takeaway}</p>
          </aside>
        }

        <section class="article-section" id="chapter-points">
          <p class="section-kind summary-kind"><span>01</span> 重要ポイント</p>
          <h2>この場面で確認する事項</h2>
          <div class="prose-points">
            {guide?.keyPoints?.map(point=>
              <div>
                <h3>{point.title}</h3>
                <p>{point.body}</p>
              </div>
            )}
          </div>
        </section>

        <section class="article-section" id="chapter-steps">
          <p class="section-kind procedure-kind"><span>02</span> 手順</p>
          <h2>実務上の進め方</h2>
          <ol class="prose-steps">
            {guide?.steps?.map(step=>
              <li>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </li>
            )}
          </ol>
        </section>

        {sourceNotes.length>0&&
          <section class="article-section source-reading" id="chapter-sources">
            <p class="section-kind source-kind"><span>03</span> 資料要約</p>
            <h2>参照資料の内容</h2>
            <p class="section-intro">参照先の内容を要約しています。実際の手続、期限、金額、例外要件を確定する場合は原典を確認してください。</p>

            <div class="source-essays">
              {sourceNotes.map(({resource,summary,points})=>
                <article class="source-essay">
                  <div class="source-essay-head">
                    <span>{resource!.sourceType==="official"?"一次情報":"実務解説"}</span>
                    <small>{resource!.provider}</small>
                  </div>
                  <h3>{resource!.title}</h3>
                  <p>{summary}</p>
                  <ul>
                    {points.map(point=><li>{point}</li>)}
                  </ul>
                  <a class="typed-link external" href={resource!.url} target="_blank" rel="noopener noreferrer"><span class="dest-tag external">4 原典</span>外部サイトで確認 <b>↗</b></a>
                </article>
              )}
            </div>
          </section>
        }

        {otherSources.length>0&&
          <section class="article-section secondary-sources" id="chapter-other-sources">
            <p class="section-kind related-kind"><span>04</span> 関連資料</p>
            <h2>追加で確認できる資料</h2>
            <div class="text-source-list">
              {otherSources.map(resource=>
                <div class="text-source-row">
                  <div>
                    <small>{resource.sourceType==="official"?"一次情報":"実務解説"} / {resource.provider}</small>
                    <strong>{resource.title}</strong>
                    <p>{resource.why}</p>
                  </div>
                  <a class="typed-link" href={"/resources/"+resource.id+"/"}><span class="dest-tag source">3 資料要約</span>概要を見る →</a>
                </div>
              )}
            </div>
          </section>
        }
      </div>
    </div>

    <nav class="chapter-navigation" aria-label="章の移動">
      {previous?<a class="previous" href={"/journey/"+previous.id+"/"}><small>← 前の場面</small><strong>{previous.title}</strong></a>:<span></span>}
      {next?<a class="next" href={"/journey/"+next.id+"/"}><small>次の場面 →</small><strong>{next.title}</strong></a>:<a class="next" href="/resources/"><small>資料一覧 →</small><strong>資料一覧</strong></a>}
    </nav>
  </article>
</BaseLayout>
