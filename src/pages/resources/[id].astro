---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { resources,events,topicMeta,sourceLabels,sortResources,type Resource } from "../../lib/data";
import { digestForResource } from "../../lib/resourceDigests";

export function getStaticPaths(){
  return resources.map(resource=>({params:{id:resource.id},props:{resource}}));
}

const { resource }=Astro.props as { resource:Resource };
const digest=digestForResource(resource);
const relatedEvents=events.filter(event=>resource.eventIds.includes(event.id));
const relatedResources=sortResources(
  resources.filter(candidate=>
    candidate.id!==resource.id &&
    candidate.topics.some(topic=>resource.topics.includes(topic))
  )
).slice(0,5);

const summary=digest.summary;
const points=digest.points;
const schema={"@context":"https://schema.org","@type":"LearningResource",name:resource.title,description:summary,provider:{"@type":"Organization",name:resource.provider},url:resource.url,inLanguage:"ja"};
---
<BaseLayout title={resource.title} description={summary} schema={schema} level="source" levelDetail={resource.title}>
  <Breadcrumbs items={[{label:"資料一覧",href:"/resources/"},{label:resource.title}]}/>

  <article class="source-article shell">
    <header class="source-article-header">
      <p class="page-type-label source-type">レベル3 / 資料要約 · {sourceLabels[resource.sourceType]} · {resource.provider}</p>
      <h1>{resource.title}</h1>
      <p class="source-article-lead">{summary}</p>
    </header>

    <nav class="chapter-in-page resource-in-page shell" aria-label="資料要約の目次">
      <strong>この資料の読み方</strong>
      <a href="#source-summary">資料の要点 ↓</a>
      {relatedEvents.length>0&&<a href="#source-scenes">使う場面 ↓</a>}
      <a href="#source-topics">専門領域 ↓</a>
      <a href="#source-original">外部原典 ↗</a>
    </nav>
    <div class="source-article-layout">
      <aside class="source-meta-rail">
        <dl>
          <div><dt>種類</dt><dd>{sourceLabels[resource.sourceType]}</dd></div>
          <div><dt>難易度</dt><dd>{resource.difficulty}</dd></div>
          <div><dt>目安</dt><dd>{resource.time}</dd></div>
          <div><dt>確認日</dt><dd>{resource.lastCheckedAt??"—"}</dd></div>
          {resource.validAsOf&&<div><dt>適用時点</dt><dd>{resource.validAsOf}</dd></div>}
        </dl>
      </aside>

      <div class="source-article-body">
        <section class="article-section first" id="source-summary">
          <p class="section-kind summary-kind"><span>01</span> 概要</p>
          <h2>資料の要点</h2>
          <p class="source-summary">{summary}</p>
          <ul class="source-key-points">
            {points.map(point=><li>{point}</li>)}
          </ul>
        </section>

        <section class="article-section" id="source-scenes">
          <p class="section-kind scene-kind"><span>02</span> 関連場面</p>
          <h2>この資料が関係する場面</h2>
          <p class="section-intro">この資料が関係する会社運営上の場面です。</p>
          <div class="inline-scenes">
            {relatedEvents.map(event=>
              <a class="typed-link scene-destination" href={"/journey/"+event.id+"/"}>
                <small><span class="dest-tag scene">1 場面</span>{event.month}</small>
                <div>
                  <strong>{event.title}</strong>
                  <span>{event.summary}</span>
                </div>
                <b>→</b>
              </a>
            )}
          </div>
        </section>

        <section class="article-section" id="source-topics">
          <p class="section-kind topic-kind"><span>03</span> 専門領域</p>
          <h2>関連する専門領域</h2>
          <div class="topic-text-links">
            {resource.topics.map(topic=>
              <a class="typed-link topic-destination" href={"/topics/"+topic+"/"}>
                <strong><span class="dest-tag topic">2 領域</span>{topicMeta[topic].label}</strong>
                <span>{topicMeta[topic].description}</span>
              </a>
            )}
          </div>
        </section>

        <section class="article-section original-source" id="source-original">
          <p class="section-kind external-kind"><span>04</span> 外部原典</p>
          <h2>参照元の公式・実務資料</h2>
          <p>手続、金額、期限、適用要件を確定する場合は、参照元の最新情報を確認してください。</p>
          <a class="original-source-link" href={resource.url} target="_blank" rel="noopener noreferrer">
            <span>
              <small>{resource.provider}</small>
              <strong>{resource.title}</strong>
            </span>
            <b><span class="dest-tag external">4 原典</span>外部サイトを開く ↗</b>
          </a>
        </section>

        {relatedResources.length>0&&
          <section class="article-section next-reading">
            <p class="section-kind related-kind"><span>05</span> 関連資料</p>
            <h2>関連する資料要約</h2>
            <div class="text-source-list">
              {relatedResources.map(item=>
                <div class="text-source-row">
                  <div>
                    <small>{sourceLabels[item.sourceType]} / {item.provider}</small>
                    <strong>{item.title}</strong>
                    <p>{digestForResource(item).summary}</p>
                  </div>
                  <a class="typed-link" href={"/resources/"+item.id+"/"}><span class="dest-tag source">3 資料要約</span>概要を見る →</a>
                </div>
              )}
            </div>
          </section>
        }
      </div>
    </div>
  </article>
</BaseLayout>
