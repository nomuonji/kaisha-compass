---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { resources, events, topicMeta, sourceLabels, sortResources, type Resource } from "../../lib/data";
import { digestFor, digestForResource } from "../../lib/resourceDigests";
import "../../styles/resource-reader.css";

export function getStaticPaths() {
  return resources.map(resource => ({ params: { id: resource.id }, props: { resource } }));
}

const { resource } = Astro.props as { resource: Resource };
const digest = digestForResource(resource);
const curated = Boolean(digestFor(resource.id));
const relatedEvents = events.filter(event => resource.eventIds.includes(event.id));
const relatedResources = sortResources(
  resources.filter(candidate =>
    candidate.id !== resource.id &&
    candidate.topics.some(topic => resource.topics.includes(topic))
  )
).slice(0, 3);

const schema = {
  "@context": "https://schema.org",
  "@type": "LearningResource",
  name: resource.title,
  description: digest.summary,
  provider: { "@type": "Organization", name: resource.provider },
  url: resource.url,
  inLanguage: "ja"
};
---
<BaseLayout title={resource.title} description={digest.summary} schema={schema} level="source" levelDetail={resource.title}>
  <Breadcrumbs items={[{ label: "資料一覧", href: "/resources/" }, { label: resource.title }]}/>

  <article class="source-article source-reader shell">
    <header class="source-reader-header">
      <div class="source-reader-heading">
        <p class="source-reader-label"><span class="dest-tag source">3 資料要約</span><span>{sourceLabels[resource.sourceType]}</span></p>
        <h1>{resource.title}</h1>
        <p class="source-reader-publisher">{resource.provider}の資料を、会社を運営する人向けに整理しています。</p>
      </div>
      <div class="source-reader-answer">
        <h2>この資料で分かること</h2>
        <p>{digest.summary}</p>
      </div>
      <dl class="source-reader-facts">
        <div><dt>発行・掲載元</dt><dd>{resource.provider}</dd></div>
        <div><dt>読む目安</dt><dd>{resource.time} · {resource.difficulty}</dd></div>
        <div><dt>リンク確認日</dt><dd>{resource.lastCheckedAt ?? "記録なし"}</dd></div>
        {resource.validAsOf && <div><dt>資料の適用時点</dt><dd>{resource.validAsOf}</dd></div>}
      </dl>
    </header>

    <nav class="source-reader-navigation" aria-label="この記事の内容">
      <strong>この記事の内容</strong>
      <a href="#source-summary">確認ポイント</a>
      <a href="#source-use">実務での使い方</a>
      <a href="#source-original">元の資料を見る ↗</a>
    </nav>

    <div class="source-reader-main">
      <section class="source-reader-section" id="source-summary">
        <div class="source-reader-section-heading">
          <span class="source-reader-step">01 / 内容</span>
          <h2>{curated ? "ここで押さえる3つのポイント" : "原典で確認したいこと"}</h2>
        </div>
        {curated
          ? <p class="source-reader-explanation">この資料について、会社の実務に関係する重要な点を整理しました。</p>
          : <p class="source-reader-explanation">この資料は内容別の詳細な解説をまだ用意していません。次の項目は、原典を読む際の確認ポイントです。</p>}
        <ol class="source-reader-points">
          {digest.points.map((point, index) =>
            <li><span class="source-reader-point-index">{String(index + 1).padStart(2, "0")}</span><p>{point}</p></li>
          )}
        </ol>
      </section>

      <section class="source-reader-section" id="source-use">
        <div class="source-reader-section-heading">
          <span class="source-reader-step">02 / 実務</span>
          <h2>会社のどんなときに使う？</h2>
        </div>
        <p class="source-reader-purpose">{resource.why}</p>

        {relatedEvents.length > 0 && <>
          <h3 class="source-reader-subheading">該当する会社運営の場面</h3>
          <div class="source-reader-scenes">
            {relatedEvents.map(event =>
              <a class="source-reader-scene" href={"/journey/" + event.id + "/"}>
                <span class="source-reader-scene-meta"><span class="dest-tag scene">1 場面</span>{event.month}</span>
                <span class="source-reader-scene-content"><strong>{event.title}</strong><span>{event.summary}</span></span>
                <span class="source-reader-arrow" aria-hidden="true">→</span>
              </a>
            )}
          </div>
        </>}

        <div class="source-reader-topics">
          <h3>関連する専門領域</h3>
          <div>
            {resource.topics.map(topic =>
              <a href={"/topics/" + topic + "/"}><span class="dest-tag topic">2 領域</span>{topicMeta[topic].label} <span aria-hidden="true">→</span></a>
            )}
          </div>
        </div>
      </section>

      <section class="source-reader-section source-reader-original" id="source-original">
        <div class="source-reader-section-heading">
          <span class="source-reader-step">03 / 原典</span>
          <h2>元の資料で確認する</h2>
        </div>
        <p>申請書、要件、金額、期限などを実際に使うときは、原典の最新情報を確認してください。この記事の最終確認日は、制度全体の現行性を保証するものではありません。</p>
        <a class="source-reader-outbound" href={resource.url} target="_blank" rel="noopener noreferrer">
          <span class="source-reader-outbound-text"><small>{resource.provider} · {sourceLabels[resource.sourceType]}</small><strong>{resource.title}</strong></span>
          <span class="source-reader-outbound-action"><span class="dest-tag external">4 原典</span>公式・実務サイトで読む <span aria-hidden="true">↗</span></span>
        </a>
      </section>

      {relatedResources.length > 0 && <aside class="source-reader-more" aria-label="次に読む資料">
        <div class="source-reader-section-heading">
          <span class="source-reader-step">続けて学ぶ</span>
          <h2>関連する資料</h2>
        </div>
        <div class="source-reader-more-list">
          {relatedResources.map(item =>
            <a href={"/resources/" + item.id + "/"} class="source-reader-more-link">
              <span class="dest-tag source">3 資料要約</span>
              <span><small>{item.provider}</small><strong>{item.title}</strong><span class="source-reader-more-description">{item.why}</span></span>
              <span aria-hidden="true">→</span>
            </a>
          )}
        </div>
        <a class="source-reader-back" href="/resources/">資料一覧に戻る →</a>
      </aside>}
    </div>
  </article>
</BaseLayout>
