---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import ResourceGrid from "../../components/ResourceGrid.astro";
import { resources,sortResources,stats } from "../../lib/data";
const sorted=sortResources(resources);
const schema={"@context":"https://schema.org","@type":"CollectionPage",name:"教材ライブラリ | Kaisha Compass",description:"会社運営に関する公式一次情報と実務解説を、学ぶ場面が分かる形で整理した教材ライブラリ。",inLanguage:"ja"};
---
<BaseLayout title="教材ライブラリ" description={"会社運営に必要な公式一次情報と実務解説を"+stats.resources+"件整理。法務・税務・労務・会計・財務・契約を横断して検索できます。"} schema={schema}>
  <Breadcrumbs items={[{label:"教材ライブラリ"}]}/>
  <section class="page-hero shell"><p class="overline"><span>LIB</span> CURATED SOURCES</p><h1>教材ライブラリ</h1><p>一次情報を先に、民間解説を補助線として。何を読むべきか迷ったときに戻ってくる資料庫です。</p><div class="page-metrics"><div><strong>{stats.resources}</strong><span>全教材</span></div><div><strong>{stats.official}</strong><span>一次情報</span></div><div><strong>{stats.practical}</strong><span>実務解説</span></div></div></section>
  <section class="library-section page-library"><div class="shell"><ResourceGrid resources={sorted} searchable/></div></section>
</BaseLayout>
